# AI Learning Path Generator - Environment variables
# Copy this file to .env and fill in your values. Do not commit .env.

# Required: Google AI Studio API key (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Gemini model name (override if needed)
GOOGLE_MODEL=gemini-2.0-flash

# --- MCP Link (recommended) ---
# Composio MCP Link credentials (required to create YouTube playlist + Drive doc via MCP toolkits)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# --- Demo vs full mode ---
# USE_DEMO_MODE=true  = Gemini only, text learning path (no Drive/YouTube).
# USE_DEMO_MODE=false = App POSTs to Pipedream webhooks to create Drive doc + YouTube playlist (see PIPEDREAM_WEBHOOKS.md).
USE_DEMO_MODE=true

# --- Google Super Mode (enabled by default) ---
# Set to false to disable and use legacy flow only.
USE_GOOGLE_SUPER_MODE=true
GOOGLE_SUPER_DEFAULT_DAYS=7
GOOGLE_SUPER_SPRINT_MODE=false

# Pipedream workflow URLs (for full mode). App sends JSON; workflows must return doc/playlist URL (see PIPEDREAM_WEBHOOKS.md).
YOUTUBE_WEBHOOK_URL=
SECONDARY_WEBHOOK_URL=
SECONDARY_WEBHOOK_TYPE=drive
